{
	"name": "Python 3",
	"image": "mcr.microsoft.com/devcontainers/python:0-3.10",
	"features": {
		"ghcr.io/devcontainers-contrib/features/pdm:2": {},
		"ghcr.io/devcontainers-contrib/features/pre-commit:2": {}
	},
	"extensions": [
		"ms-python.python",
		"ms-python.vscode-pylance",
		"esbenp.prettier-vscode",
		"eamodio.gitlens"
	],
	"settings": {
		"python.pythonPath": "/usr/local/bin/python",
		"python.linting.enabled": true,
		"editor.formatOnSave": true
	},
	"forwardPorts": [
		5000,
		8000
	],
	// "postCreateCommand": "pip3 install --user -r requirements.txt && ./setup.sh",
	"postCreateCommand": "pdm install",
	"remoteUser": "vscode",
	"mounts": [
		"source=${localWorkspaceFolder}/data,target=/workspace/data,type=volume,volume-driver=local"
	],
	"containerEnv": {
		"MY_CUSTOM_ENV_VAR": "value"
	}
}
